# Copy to .env for local development. Fill in values for your own test setup.
# Only public values belong in variables prefixed with VITE_.
VITE_APP_ID=semiguard-local-example

# Use a separate local or test database and a fresh local signing secret.
DATABASE_URL=
JWT_SECRET=

# Optional server-side credentials. Set only for the feature you are testing.
NVIDIA_API_KEY=
OGQ_API_KEY=
